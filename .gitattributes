# Set line ending handling to auto
* text=auto

# Python files
*.py text eol=lf

# Shell scripts
*.sh text eol=lf
*.bat text eol=crlf

# Markdown
*.md text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.pkl binary
*.pyc binary
*.pyo binary
*.db binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.gif binary
*.jpg binary
*.jpeg binary
*.png binary
*.mp4 binary
*.avi binary